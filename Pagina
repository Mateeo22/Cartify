<!DOCTYPE html>
<html lang="es" class="h-full bg-[#fdf8f4]">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mimo Gift - Crea un Regalo Digital Inolvidable</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mimo: {
                            bg: '#fdf8f4',
                            card: '#ffffff',
                            primary: '#d97757',
                            primaryHover: '#c86b58',
                            secondary: '#f7e7df',
                            text: '#2d2727',
                            muted: '#7a706e',
                            border: '#ebdcd5',
                            accent: '#e29578'
                        }
                    },
                    fontFamily: {
                        serif: ['Playfair Display', 'Georgia', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,400&display=swap" rel="stylesheet">

    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Leaflet JS & CSS for interactive maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>

    <!-- Canvas Confetti Library -->
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

    <style>
        body {
            font-family: 'Inter', sans-serif;
            color: #2d2727;
            background-color: #fdf8f4;
            overflow-x: hidden;
        }

        h1, h2, h3, .font-serif-title {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* Smooth custom transitions */
        .fade-in {
            animation: fadeIn 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* Pulse heart animation */
        @keyframes pulseHeart {
            0%, 100% { transform: scale(1); }
            50% { transform: scale(1.18); }
        }

        .animate-heartbeat {
            animation: pulseHeart 1.4s infinite ease-in-out;
        }

        /* Custom scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #fdf8f4;
        }
        ::-webkit-scrollbar-thumb {
            background: #e29578;
            border-radius: 9999px;
        }

        /* Published Theme Variations */
        .theme-atardecer {
            --bg-main: #fdf8f4;
            --card-bg: #ffffff;
            --accent-color: #d97757;
            --text-color: #2d2727;
            --gradient-header: linear-gradient(135deg, #fceade 0%, #f7d6c8 100%);
        }
        .theme-noche {
            --bg-main: #0f172a;
            --card-bg: #1e293b;
            --accent-color: #f43f5e;
            --text-color: #f8fafc;
            --gradient-header: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
        }
        .theme-rosa {
            --bg-main: #fff5f7;
            --card-bg: #ffffff;
            --accent-color: #e11d48;
            --text-color: #331018;
            --gradient-header: linear-gradient(135deg, #ffe4e6 0%, #fecdd3 100%);
        }
        .theme-jardin {
            --bg-main: #f4f7f4;
            --card-bg: #ffffff;
            --accent-color: #2e6f40;
            --text-color: #1a2e20;
            --gradient-header: linear-gradient(135deg, #e2efe4 0%, #cce3cf 100%);
        }

        /* Floating background hearts animation */
        .floating-heart {
            position: fixed;
            pointer-events: none;
            z-index: 0;
            animation: floatUp 8s linear infinite;
            opacity: 0.6;
        }

        @keyframes floatUp {
            0% { transform: translateY(100vh) scale(0.5) rotate(0deg); opacity: 0; }
            20% { opacity: 0.7; }
            80% { opacity: 0.7; }
            100% { transform: translateY(-10vh) scale(1.2) rotate(360deg); opacity: 0; }
        }
    </style>
</head>

<body class="min-h-full flex flex-col justify-between antialiased selection:bg-mimo-primary selection:text-white">

    <!-- Floating Background Decorator Container -->
    <div id="floatingHeartsContainer" class="fixed inset-0 pointer-events-none overflow-hidden z-0"></div>

    <!-- Top Header -->
    <header class="sticky top-0 z-40 bg-[#fdf8f4]/90 backdrop-blur-md border-b border-mimo-border px-4 py-3 transition-all duration-300">
        <div class="max-w-3xl mx-auto flex items-center justify-between">
            <!-- Brand Logo -->
            <div class="flex items-center gap-2 cursor-pointer" onclick="goToStep(0)">
                <span class="bg-mimo-primary text-white w-8 h-8 rounded-full flex items-center justify-center text-sm shadow-sm">
                    <i class="fa-solid fa-heart animate-heartbeat"></i>
                </span>
                <span class="font-serif text-xl font-bold tracking-tight text-mimo-text">Mimo<span class="text-mimo-primary">Gift</span></span>
            </div>

            <!-- Indicator & Step Pill -->
            <div id="headerProgressContainer" class="flex items-center gap-3">
                <div class="hidden sm:flex flex-col items-end">
                    <span id="stepTitleIndicator" class="text-xs font-semibold text-mimo-muted uppercase tracking-wider">Paso 1 de 12</span>
                    <span id="recipientBadge" class="text-xs font-medium text-mimo-primary bg-mimo-secondary px-2 py-0.5 rounded-full">❤️ Pareja</span>
                </div>
                <div class="w-28 sm:w-36 h-2.5 bg-mimo-secondary rounded-full overflow-hidden p-0.5 border border-mimo-border">
                    <div id="progressBar" class="h-full bg-mimo-primary rounded-full transition-all duration-500 ease-out" style="width: 8%;"></div>
                </div>
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <main class="flex-1 max-w-3xl w-full mx-auto px-4 py-6 z-10">
        <div id="appContainer" class="w-full">
            <!-- Dynamic step contents will render here via JS -->
        </div>
    </main>

    <!-- Bottom Fixed Navigation Footer -->
    <footer id="bottomNav" class="sticky bottom-0 z-40 bg-white/95 backdrop-blur-md border-t border-mimo-border px-4 py-3 shadow-lg">
        <div class="max-w-3xl mx-auto flex items-center justify-between gap-3">
            <!-- Back Button -->
            <button id="btnBack" onclick="prevStep()" class="flex items-center gap-2 px-4 py-2.5 rounded-xl border border-mimo-border text-mimo-muted font-medium hover:bg-mimo-bg hover:text-mimo-text transition text-sm">
                <i class="fa-solid fa-arrow-left text-xs"></i>
                <span>Atrás</span>
            </button>

            <!-- Center Quick Preview Trigger -->
            <button id="btnPreviewModal" onclick="openQuickPreviewModal()" class="flex items-center gap-1.5 px-3 py-2 rounded-xl text-mimo-primary bg-mimo-secondary/60 hover:bg-mimo-secondary text-xs font-medium transition">
                <i class="fa-solid fa-eye"></i>
                <span class="hidden sm:inline">Vista Previa</span>
            </button>

            <!-- Main Next / Action Button -->
            <button id="btnNext" onclick="nextStep()" class="flex items-center gap-2 px-6 py-2.5 rounded-xl bg-mimo-primary text-white font-semibold hover:bg-mimo-primaryHover transition shadow-md shadow-mimo-primary/20 text-sm">
                <span id="btnNextText">Continuar</span>
                <i id="btnNextIcon" class="fa-solid fa-arrow-right text-xs"></i>
            </button>
        </div>
    </footer>

    <!-- Modal: Quick Live Preview -->
    <div id="quickPreviewModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm hidden">
        <div class="bg-white rounded-2xl max-w-md w-full max-h-[85vh] flex flex-col shadow-2xl overflow-hidden border border-mimo-border animate-fadeIn">
            <div class="bg-mimo-bg p-4 border-b border-mimo-border flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fa-solid fa-mobile-screen text-mimo-primary"></i>
                    <h3 class="font-serif font-bold text-mimo-text text-base">Vista Previa Rápida</h3>
                </div>
                <button onclick="closeQuickPreviewModal()" class="text-mimo-muted hover:text-mimo-text p-1">
                    <i class="fa-solid fa-xmark text-lg"></i>
                </button>
            </div>
            <div class="p-6 overflow-y-auto flex-1 space-y-4" id="quickPreviewContent">
                <!-- Live preview details populate dynamically -->
            </div>
            <div class="p-3 bg-mimo-bg border-t border-mimo-border text-center">
                <button onclick="closeQuickPreviewModal()" class="w-full py-2 bg-mimo-primary text-white rounded-xl font-medium text-sm">
                    Seguir Editando
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: Notification / Alert Custom Message -->
    <div id="customAlertModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/50 backdrop-blur-xs hidden">
        <div class="bg-white rounded-2xl max-w-xs w-full p-5 text-center shadow-2xl border border-mimo-border">
            <div id="customAlertIcon" class="w-12 h-12 bg-mimo-secondary text-mimo-primary rounded-full flex items-center justify-center mx-auto mb-3 text-xl">
                <i class="fa-solid fa-heart"></i>
            </div>
            <h4 id="customAlertTitle" class="font-serif font-bold text-lg text-mimo-text mb-1">Aviso</h4>
            <p id="customAlertMessage" class="text-sm text-mimo-muted mb-4">Mensaje de prueba</p>
            <button onclick="closeCustomAlert()" class="w-full py-2 bg-mimo-primary text-white rounded-xl text-sm font-semibold hover:bg-mimo-primaryHover transition">
                Entendido
            </button>
        </div>
    </div>

    <script>
        const appState = {
            step: 0, // 0 = Recipient choice, 1-12 = Flow steps, 13 = Checkout, 14 = Final Gift View
            recipient: 'pareja', // 'pareja' or 'mama'
            senderName: '',
            recipientName: '',
            startDate: '',
            unknownDate: false,
            photos: [], // Base64 image strings
            musicTrack: 'piano', // 'piano', 'acoustic', 'romantic'
            letter: '',
            reasons: [],
            plans: [],
            mapLocation: {
                lat: -34.6037,
                lng: -58.3816,
                title: 'Nuestro Lugar Especial'
            },
            vouchers: [],
            memories: [],
            finalQuestion: '',
            selectedTheme: 'atardecer',
            isPaid: false,
            // Live ticker handles
            tickerInterval: null
        };

        // Default Presets according to recipient
        const PRESETS = {
            pareja: {
                recipientLabel: '❤️ Para mi Novi@ / Pareja',
                defaultSender: '',
                defaultRecipient: '',
                startDateDefault: '2026-02-14',
                letterSuggestion: 'Gracias por ser mi lugar seguro y por hacerme sonreír cada día. Desde el primer instante supe que eras alguien verdaderamente especial en mi vida. Te amo infinitamente.',
                letterChips: [
                    "Gracias por hacerme la persona más feliz del mundo cada día ❤️",
                    "Desde que llegaste a mi vida todo cobró un color más bonito ✨",
                    "Contigo aprendí lo hermoso que es amar sin reservas 🌹",
                    "No importa a dónde vayamos, mi lugar favorito siempre es a tu lado."
                ],
                reasonsSuggestions: [
                    "Tu sonrisa sincera que ilumina cualquier día gris",
                    "La forma dulcísima en que me miras a los ojos",
                    "Tus abrazos reconfortantes cuando más los necesito",
                    "Lo detallista y atento/a que eres siempre conmigo",
                    "Tus risas contagiosas y bromas compartidas"
                ],
                plansSuggestions: [
                    "Cita de picnic romántico viendo el atardecer",
                    "Maratón de películas en un día lluvioso con chocolate caliente",
                    "Un viaje juntos a una ciudad o playa que soñamos conocer",
                    "Cocinar una cena italiana gourmet en pareja",
                    "Ir a un concierto de nuestra banda favorita"
                ],
                vouchersList: [
                    { id: 1, text: '🎟️ Vale por un beso súper apasionado de 10 segundos', icon: 'fa-kiss-wink-heart' },
                    { id: 2, text: '🎟️ Vale por un masaje relajante de espalda (30 min)', icon: 'fa-hands' },
                    { id: 3, text: '🎟️ Vale por una cena romántica preparada por mí', icon: 'fa-utensils' },
                    { id: 4, text: '🎟️ Vale por no pelear ni discutir en todo el día', icon: 'fa-dove' },
                    { id: 5, text: '🎟️ Vale por tu postre favorito traído a la cama', icon: 'fa-ice-cream' }
                ],
                memoriesList: [
                    { date: 'El inicio', title: 'Nuestra primera cita', desc: 'Aquel café donde el tiempo se pasó volando y no queríamos despedirnos.' },
                    { date: 'Un día inolvidable', title: 'Nuestro primer viaje juntos', desc: 'Risas, fotos y recuerdos grabados en el corazón para siempre.' }
                ],
                questionDefault: '¿Aceptas seguir construyendo esta hermosa historia de amor conmigo?'
            },
            mama: {
                recipientLabel: '🌷 Para mi Mamá',
                defaultSender: '',
                defaultRecipient: '',
                startDateDefault: '1998-05-10',
                letterSuggestion: 'Mamá, no existen suficientes palabras para agradecerte por tu amor incondicional, tu paciencia infinita y por siempre dar todo por mí. Eres mi mayor ejemplo y la persona que más admiro.',
                letterChips: [
                    "Mamá, gracias por tu entrega incondicional y tu abrazo sanador 🌷",
                    "Eres la mujer más valiente, noble y fuerte que conozco en este mundo.",
                    "Gracias por cada consejo, cada comida hecha con amor y cada esfuerzo ❤️",
                    "No hay refugio más cálido ni seguro en el mundo que tus brazos."
                ],
                reasonsSuggestions: [
                    "Tu paciencia infinita y tu capacidad de escuchar siempre",
                    "Tus deliciosas comidas caseras preparadas con puro amor",
                    "Tu fortaleza ante cualquier obstáculo de la vida",
                    "Tus abrazos reconfortantes que curan cualquier pena",
                    "Tu amor incondicional sin juzgar jamás"
                ],
                plansSuggestions: [
                    "Un día entero de Spa, masajes y relajación total para ti",
                    "Una salida a cenar a tu restaurante preferido para consentirte",
                    "Cocinarte tu plato favorito para que hoy no tengas que hacer nada",
                    "Irmos de viaje juntas/os a ese lugar que sueñas visitar",
                    "Tarde de té, fotos familiares antiguas y café juntas/os"
                ],
                vouchersList: [
                    { id: 1, text: '🎟️ Vale por un día libre completo sin cocinar ni limpiar', icon: 'fa-spa' },
                    { id: 2, text: '🎟️ Vale por un abrazo gigante de 5 minutos seguidos', icon: 'fa-heart' },
                    { id: 3, text: '🎟️ Vale por prepararte tu plato favorito a la carta', icon: 'fa-concierge-bell' },
                    { id: 4, text: '🎟️ Vale por un paseo juntos a tomar café y pastel', icon: 'fa-mug-hot' },
                    { id: 5, text: '🎟️ Vale por ayudarte en todo lo que necesites hoy', icon: 'fa-hand-holding-heart' }
                ],
                memoriesList: [
                    { date: 'Siempre en mi mente', title: 'Tus primeros consejos', desc: 'Esas palabras sabias que moldearon mi camino y quien soy hoy.' },
                    { date: 'Momento especial', title: 'Aquel viaje o festejo familiar', desc: 'La felicidad pura de verte sonreír rodeada de los tuyos.' }
                ],
                questionDefault: '¿Sabías que eres la mamá más increíble y maravillosa de todo el universo?'
            }
        };

        // Sample photos placeholders
        const SAMPLE_PHOTOS = [
            'https://images.unsplash.com/photo-1518199266791-5375a83190b7?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1516589178581-6cd7833ae3b2?auto=format&fit=crop&w=600&q=80',
            'https://images.unsplash.com/photo-1522673607200-164d1b6ce486?auto=format&fit=crop&w=600&q=80'
        ];

        window.addEventListener('DOMContentLoaded', () => {
            // Set initial defaults
            setRecipientDefaults('pareja');
            createFloatingHearts();
            renderStep();
        });

        function setRecipientDefaults(type) {
            appState.recipient = type;
            const preset = PRESETS[type];
            appState.senderName = appState.senderName || preset.defaultSender;
            appState.recipientName = preset.defaultRecipient;
            appState.startDate = preset.startDateDefault;
            appState.letter = preset.letterSuggestion;
            appState.reasons = [...preset.reasonsSuggestions.slice(0, 3)];
            appState.plans = [...preset.plansSuggestions.slice(0, 3)];
            appState.vouchers = preset.vouchersList.map(v => v.text);
            appState.memories = [...preset.memoriesList];
            appState.finalQuestion = preset.questionDefault;
            if (appState.photos.length === 0) {
                appState.photos = [...SAMPLE_PHOTOS];
            }
        }

        function createFloatingHearts() {
            const container = document.getElementById('floatingHeartsContainer');
            container.innerHTML = '';
            const icons = ['fa-heart', 'fa-sparkles', 'fa-star', 'fa-heart-pulse'];
            for (let i = 0; i < 12; i++) {
                const el = document.createElement('i');
                const randomIcon = icons[Math.floor(Math.random() * icons.length)];
                el.className = `fa-solid ${randomIcon} floating-heart text-mimo-accent/20`;
                el.style.left = `${Math.random() * 95}%`;
                el.style.fontSize = `${Math.random() * 16 + 12}px`;
                el.style.animationDelay = `${Math.random() * 6}s`;
                el.style.animationDuration = `${Math.random() * 6 + 6}s`;
                container.appendChild(el);
            }
        }

        function goToStep(s) {
            appState.step = s;
            renderStep();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function nextStep() {
            if (appState.step === 0) {
                appState.step = 1;
            } else if (appState.step < 13) {
                appState.step++;
            }
            renderStep();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function prevStep() {
            if (appState.step > 0 && appState.step <= 13) {
                appState.step--;
                renderStep();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            }
        }

        function renderStep() {
            const container = document.getElementById('appContainer');
            const nav = document.getElementById('bottomNav');
            const headerProgress = document.getElementById('headerProgressContainer');
            const stepTitleInd = document.getElementById('stepTitleIndicator');
            const badge = document.getElementById('recipientBadge');
            const progressBar = document.getElementById('progressBar');
            const btnNextText = document.getElementById('btnNextText');
            const btnBack = document.getElementById('btnBack');

            // Update header badge
            badge.textContent = PRESETS[appState.recipient].recipientLabel;

            // Handle special screens (Checkout or Published View)
            if (appState.step === 0) {
                headerProgress.classList.add('hidden');
                nav.classList.add('hidden');
            } else if (appState.step === 13 || appState.step === 14) {
                headerProgress.classList.add('hidden');
                nav.classList.add('hidden');
            } else {
                headerProgress.classList.remove('hidden');
                nav.classList.remove('hidden');
                stepTitleInd.textContent = `Paso ${appState.step} de 12`;
                const pct = Math.round((appState.step / 12) * 100);
                progressBar.style.width = `${pct}%`;
                btnNextText.textContent = appState.step === 12 ? 'Ver Cobro y Publicar' : 'Continuar';
                btnBack.style.visibility = appState.step === 1 ? 'visible' : 'visible';
            }

            // Render specific screen content
            switch (appState.step) {
                case 0: container.innerHTML = renderStep0Recipient(); break;
                case 1: container.innerHTML = renderStep1Names(); break;
                case 2: container.innerHTML = renderStep2Date(); initLiveTicker(); break;
                case 3: container.innerHTML = renderStep3Photos(); break;
                case 4: container.innerHTML = renderStep4Music(); break;
                case 5: container.innerHTML = renderStep5Letter(); break;
                case 6: container.innerHTML = renderStep6Reasons(); break;
                case 7: container.innerHTML = renderStep7Plans(); break;
                case 8: container.innerHTML = renderStep8Map(); setTimeout(initLeafletMap, 100); break;
                case 9: container.innerHTML = renderStep9Vouchers(); break;
                case 10: container.innerHTML = renderStep10Memories(); break;
                case 11: container.innerHTML = renderStep11Question(); break;
                case 12: container.innerHTML = renderStep12Theme(); break;
                case 13: container.innerHTML = renderStep13Checkout(); break;
                case 14: container.innerHTML = renderPublishedPage(); initLiveTickerPublished(); break;
            }
        }

        function renderStep0Recipient() {
            return `
            <div class="fade-in max-w-lg mx-auto text-center py-6">
                <div class="inline-flex items-center justify-center w-16 h-16 bg-mimo-secondary text-mimo-primary rounded-full mb-4 shadow-inner text-2xl">
                    <i class="fa-solid fa-gift animate-heartbeat"></i>
                </div>
                <h1 class="text-3xl sm:text-4xl font-serif font-bold text-mimo-text mb-3">¿Para quién es esta página especial?</h1>
                <p class="text-mimo-muted text-sm sm:text-base mb-8 max-w-md mx-auto">
                    Selecciona a la persona protagonista. Adaptaremos toda la experiencia, textos, vales de regalo y sorpresas.
                </p>

                <div class="grid grid-cols-1 gap-4 text-left">
                    <!-- Option 1: Pareja -->
                    <div onclick="selectRecipientChoice('pareja')" class="group relative p-5 bg-white border-2 ${appState.recipient === 'pareja' ? 'border-mimo-primary ring-2 ring-mimo-primary/20' : 'border-mimo-border'} rounded-2xl shadow-sm hover:shadow-md cursor-pointer transition-all duration-200">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-rose-100 text-rose-500 rounded-2xl flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                                <i class="fa-solid fa-heart"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between">
                                    <h3 class="font-serif font-bold text-lg text-mimo-text">Para mi Novi@ / Pareja</h3>
                                    ${appState.recipient === 'pareja' ? '<i class="fa-solid fa-circle-check text-mimo-primary text-xl"></i>' : ''}
                                </div>
                                <p class="text-xs text-mimo-muted mt-1">Tono romántico, contador de tiempo de noviazgo, vales de citas y preguntas de amor.</p>
                            </div>
                        </div>
                    </div>

                    <!-- Option 2: Mamá -->
                    <div onclick="selectRecipientChoice('mama')" class="group relative p-5 bg-white border-2 ${appState.recipient === 'mama' ? 'border-mimo-primary ring-2 ring-mimo-primary/20' : 'border-mimo-border'} rounded-2xl shadow-sm hover:shadow-md cursor-pointer transition-all duration-200">
                        <div class="flex items-start gap-4">
                            <div class="w-12 h-12 bg-amber-100 text-amber-600 rounded-2xl flex items-center justify-center text-xl shrink-0 group-hover:scale-105 transition">
                                <i class="fa-solid fa-wand-magic-sparkles"></i>
                            </div>
                            <div class="flex-1">
                                <div class="flex items-center justify-between">
                                    <h3 class="font-serif font-bold text-lg text-mimo-text">Para mi Mamá</h3>
                                    ${appState.recipient === 'mama' ? '<i class="fa-solid fa-circle-check text-mimo-primary text-xl"></i>' : ''}
                                </div>
                                <p class="text-xs text-mimo-muted mt-1">Tono de cariño y agradecimiento filial, recuerdos de familia y vales de mimos.</p>
                            </div>
                        </div>
