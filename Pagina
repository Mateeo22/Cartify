                </div>

                <!-- Photo Gallery Grid -->
                <div class="space-y-2">
                    <h3 class="font-serif font-bold text-xl text-mimo-text text-center">Nuestros Recuerdos</h3>
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                        ${photoGallery}
                    </div>
                </div>

                <!-- Letter Box -->
                <div class="bg-white/90 backdrop-blur-md p-8 rounded-3xl border border-mimo-border shadow-md space-y-4 text-center relative overflow-hidden">
                    <i class="fa-solid fa-quote-left text-4xl text-mimo-secondary absolute top-4 left-4 -z-0"></i>
                    <h3 class="font-serif font-bold text-2xl text-mimo-text relative z-10">Carta para Ti</h3>
                    <p class="font-serif text-base text-mimo-text leading-relaxed whitespace-pre-line italic relative z-10">
                        "${escapeHtml(appState.letter)}"
                    </p>
                    <div class="pt-2 text-right">
                        <span class="font-serif font-bold text-sm text-mimo-primary block">Con todo mi amor,</span>
                        <span class="font-serif font-bold text-lg text-mimo-text">${appState.senderName}</span>
                    </div>
                </div>

                <!-- What I Love Most / Reasons -->
                <div class="space-y-3">
                    <h3 class="font-serif font-bold text-xl text-mimo-text text-center">
                        ${appState.recipient === 'pareja' ? 'Lo que más amo de ti' : 'Lo que más le agradezco a Mamá'}
                    </h3>
                    <ul class="space-y-2">
                        ${reasonsList}
                    </ul>
                </div>

                <!-- Future Plans -->
                <div class="space-y-3">
                    <h3 class="font-serif font-bold text-xl text-mimo-text text-center">Planes Futuros por Cumplir</h3>
                    <ul class="space-y-2">
                        ${plansList}
                    </ul>
                </div>

                <!-- Redeemable Vouchers -->
                <div class="space-y-3">
                    <h3 class="font-serif font-bold text-xl text-mimo-text text-center">Tus Vales de Regalo Canjeables</h3>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        ${vouchersCards}
                    </div>
                </div>

                <!-- Timeline Memories -->
                <div class="bg-white/90 backdrop-blur-md p-6 rounded-3xl border border-mimo-border shadow-md space-y-4">
                    <h3 class="font-serif font-bold text-xl text-mimo-text text-center">Línea del Tiempo</h3>
                    <div class="space-y-1">
                        ${memoriesTimeline}
                    </div>
                </div>

                <!-- Final Interactive Question Card -->
                <div class="bg-gradient-to-br from-mimo-secondary to-rose-100 p-8 rounded-3xl border border-mimo-border shadow-lg text-center space-y-6 relative overflow-hidden">
                    <h3 class="font-serif font-bold text-2xl sm:text-3xl text-mimo-text">${escapeHtml(appState.finalQuestion)}</h3>
                    <div class="flex items-center justify-center gap-4 relative min-h-[50px]">
                        <button onclick="triggerFinalYesConfetti()" class="px-8 py-3 bg-mimo-primary text-white font-bold rounded-2xl shadow-lg hover:scale-110 transition text-lg">
                            ¡Sí! ❤️
                        </button>
                        <button id="publishedBtnNo" onmouseover="runawayPublishedNoButton()" onclick="runawayPublishedNoButton()" class="px-8 py-3 bg-white text-mimo-muted font-bold rounded-2xl shadow-sm transition-all duration-200 text-lg">
                            No
                        </button>
                    </div>
                </div>
            </div>
            `;
        }

        function initLiveTickerPublished() {
            if (appState.tickerInterval) clearInterval(appState.tickerInterval);
            updateTickerPublished();
            appState.tickerInterval = setInterval(updateTickerPublished, 1000);
        }

        function updateTickerPublished() {
            const grid = document.getElementById('publishedTickerGrid');
            if (!grid || !appState.startDate) return;

            const diff = calculateTimeDiff(new Date(appState.startDate));
            grid.innerHTML = `
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.years}</span><span class="text-[10px] text-mimo-muted uppercase">Años</span></div>
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.months}</span><span class="text-[10px] text-mimo-muted uppercase">Meses</span></div>
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.days}</span><span class="text-[10px] text-mimo-muted uppercase">Días</span></div>
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.hours}</span><span class="text-[10px] text-mimo-muted uppercase">Horas</span></div>
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.minutes}</span><span class="text-[10px] text-mimo-muted uppercase">Min</span></div>
                <div class="bg-mimo-bg p-2 rounded-xl border border-mimo-border"><span class="text-lg font-bold text-mimo-primary block">${diff.seconds}</span><span class="text-[10px] text-mimo-muted uppercase">Seg</span></div>
            `;
        }

        function redeemVoucher(index) {
            const el = document.getElementById(`voucherPublished_${index}`);
            if (el) {
                el.className = 'p-4 bg-emerald-50 rounded-2xl border-2 border-emerald-400 shadow-sm transition flex items-center justify-between opacity-80';
                el.innerHTML = `
                    <span class="text-xs font-bold text-emerald-800 line-through">${appState.vouchers[index]}</span>
                    <span class="text-[10px] font-bold uppercase bg-emerald-200 text-emerald-800 px-2 py-1 rounded-full shrink-0">¡Canjeado!</span>
                `;
            }
        }

        function triggerFinalYesConfetti() {
            confetti({
                particleCount: 150,
                spread: 100,
                origin: { y: 0.6 }
            });
            showCustomAlert("¡Inolvidable!", "Has respondido SÍ ❤️ Tu amor ha quedado grabado para siempre.");
        }

        function runawayPublishedNoButton() {
            const btn = document.getElementById('publishedBtnNo');
            if (!btn) return;
            const x = (Math.random() - 0.5) * 200;
            const y = (Math.random() - 0.5) * 80;
            btn.style.transform = `translate(${x}px, ${y}px)`;
        }

        function copyPublishedLink() {
            const dummyUrl = `https://mimogift.app/v/${encodeURIComponent(appState.senderName.toLowerCase())}-${encodeURIComponent(appState.recipientName.toLowerCase())}`;
            const tempInput = document.createElement('input');
            tempInput.value = dummyUrl;
            document.body.appendChild(tempInput);
            tempInput.select();
            document.execCommand('copy');
            document.body.removeChild(tempInput);

            showCustomAlert("¡Enlace Copiado!", `El enlace de tu página es:\n${dummyUrl}`);
        }

        function openQuickPreviewModal() {
            const modal = document.getElementById('quickPreviewModal');
            const content = document.getElementById('quickPreviewContent');
            content.innerHTML = `
                <div class="text-center space-y-2">
                    <span class="text-xs font-bold uppercase tracking-wider text-mimo-primary bg-mimo-secondary px-3 py-1 rounded-full">
                        ${PRESETS[appState.recipient].recipientLabel}
                    </span>
                    <h4 class="font-serif font-bold text-xl text-mimo-text">${appState.senderName || 'Tu Nombre'} & ${appState.recipientName || 'Su Nombre'}</h4>
                    <p class="text-xs text-mimo-muted italic">" ${appState.letter ? appState.letter.substring(0, 100) + '...' : 'Carta en borrador'} "</p>
                </div>

                <div class="bg-mimo-bg p-3 rounded-xl border border-mimo-border text-xs space-y-1">
                    <span class="font-bold text-mimo-text block">Resumen del Estado:</span>
                    <p>• Fotos subidas: ${appState.photos.length}</p>
                    <p>• Vales activos: ${appState.vouchers.length}</p>
                    <p>• Tema visual: ${appState.selectedTheme}</p>
                </div>
            `;
            modal.classList.remove('hidden');
        }

        function closeQuickPreviewModal() {
            document.getElementById('quickPreviewModal').classList.add('hidden');
        }

        function showCustomAlert(title, msg) {
            const modal = document.getElementById('customAlertModal');
            document.getElementById('customAlertTitle').textContent = title;
            document.getElementById('customAlertMessage').textContent = msg;
            modal.classList.remove('hidden');
        }

        function closeCustomAlert() {
            document.getElementById('customAlertModal').classList.add('hidden');
        }

        function escapeHtml(str) {
            if (!str) return '';
            return str.replace(/&/g, "&amp;")
                      .replace(/</g, "&lt;")
                      .replace(/>/g, "&gt;")
                      .replace(/"/g, "&quot;")
                      .replace(/'/g, "&#039;");
        }
    </script>
</body>
</html>
