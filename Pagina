        function updateTickerUI() {
            const grid = document.getElementById('liveTickerGrid');
            if (!grid || !appState.startDate || appState.unknownDate) return;

            const diff = calculateTimeDiff(new Date(appState.startDate));
            grid.innerHTML = `
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.years}</span><span class="text-[10px] text-mimo-muted uppercase">Años</span></div>
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.months}</span><span class="text-[10px] text-mimo-muted uppercase">Meses</span></div>
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.days}</span><span class="text-[10px] text-mimo-muted uppercase">Días</span></div>
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.hours}</span><span class="text-[10px] text-mimo-muted uppercase">Horas</span></div>
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-text block">${diff.minutes}</span><span class="text-[10px] text-mimo-muted uppercase">Min</span></div>
                <div class="bg-white p-2 rounded-lg border border-mimo-border"><span class="text-lg font-bold text-mimo-primary block">${diff.seconds}</span><span class="text-[10px] text-mimo-muted uppercase">Seg</span></div>
            `;
        }

        function calculateTimeDiff(start) {
            const now = new Date();
            let delta = Math.abs(now - start) / 1000;

            const years = Math.floor(delta / 31536000);
            delta -= years * 31536000;

            const months = Math.floor(delta / 2592000);
            delta -= months * 2592000;

            const days = Math.floor(delta / 86400);
            delta -= days * 86400;

            const hours = Math.floor(delta / 3600) % 24;
            delta -= hours * 3600;

            const minutes = Math.floor(delta / 60) % 60;
            const seconds = Math.floor(delta % 60);

            return { years, months, days, hours, minutes, seconds };
        }

