        function initLeafletMap() {
            const mapContainer = document.getElementById('leafletMapContainer');
            if (!mapContainer) return;

            mapInstance = L.map('leafletMapContainer').setView([appState.mapLocation.lat, appState.mapLocation.lng], 12);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '&copy; OpenStreetMap'
            }).addTo(mapInstance);

            markerInstance = L.marker([appState.mapLocation.lat, appState.mapLocation.lng], { draggable: true }).addTo(mapInstance);
            markerInstance.bindPopup(appState.mapLocation.title).openPopup();

            mapInstance.on('click', function(e) {
                appState.mapLocation.lat = e.latlng.lat;
                appState.mapLocation.lng = e.latlng.lng;
                markerInstance.setLatLng(e.latlng);
                markerInstance.bindPopup(appState.mapLocation.title || 'Lugar Especial').openPopup();
            });

            markerInstance.on('dragend', function(e) {
                const pos = markerInstance.getLatLng();
                appState.mapLocation.lat = pos.lat;
                appState.mapLocation.lng = pos.lng;
            });
        }

